# ==================================================
# DBVC Environment Variables Example
# ==================================================
# Copy this file to .env for local/server usage.
# Never commit the real .env file.
# Values below are local-development examples only.

# ------------------
# Backend server
# ------------------
SERVER_PORT=8085

# ------------------
# Main DBVC platform database
# ------------------
DBVC_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DBVC_DATASOURCE_USERNAME=DBVC
DBVC_DATASOURCE_PASSWORD=Dbvc123
DBVC_DATASOURCE_DRIVER=oracle.jdbc.OracleDriver

# ------------------
# Managed environments
# ------------------
DBVC_ENV_DEV_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DBVC_ENV_DEV_USERNAME=DBVC_DEV
DBVC_ENV_DEV_PASSWORD=Dev123

DBVC_ENV_TEST_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DBVC_ENV_TEST_USERNAME=DBVC_TEST
DBVC_ENV_TEST_PASSWORD=Test123

DBVC_ENV_PROD_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DBVC_ENV_PROD_USERNAME=DBVC_PROD
DBVC_ENV_PROD_PASSWORD=Prod123

# ------------------
# Authentication
# ------------------
DBVC_JWT_SECRET=change-this-local-development-secret-key-please-keep-it-long
DBVC_JWT_ISSUER=dbvc-platform
DBVC_JWT_EXPIRATION_MINUTES=480

DBVC_AUTH_DEFAULT_ADMIN_USERNAME=admin
DBVC_AUTH_DEFAULT_ADMIN_PASSWORD=Admin123!

# ------------------
# Artifact storage - local MinIO
# ------------------
DBVC_ARTIFACT_STORAGE_ENABLED=true
DBVC_ARTIFACT_STORAGE_PROVIDER=minio
DBVC_ARTIFACT_STORAGE_ENDPOINT=http://localhost:9000
DBVC_ARTIFACT_STORAGE_REGION=us-east-1
DBVC_ARTIFACT_STORAGE_BUCKET=dbvc-artifacts
DBVC_ARTIFACT_STORAGE_CREDENTIALS_MODE=static
DBVC_ARTIFACT_STORAGE_ACCESS_KEY=minioadmin
DBVC_ARTIFACT_STORAGE_SECRET_KEY=minioadmin
DBVC_ARTIFACT_STORAGE_PATH_STYLE_ACCESS=true

# ------------------
# Artifact storage - AWS S3 with IAM Role example
# ------------------
# DBVC_ARTIFACT_STORAGE_PROVIDER=s3
# DBVC_ARTIFACT_STORAGE_ENDPOINT=
# DBVC_ARTIFACT_STORAGE_REGION=eu-west-3
# DBVC_ARTIFACT_STORAGE_BUCKET=dbvc-prod-artifacts
# DBVC_ARTIFACT_STORAGE_CREDENTIALS_MODE=default
# DBVC_ARTIFACT_STORAGE_ACCESS_KEY=
# DBVC_ARTIFACT_STORAGE_SECRET_KEY=
# DBVC_ARTIFACT_STORAGE_PATH_STYLE_ACCESS=false