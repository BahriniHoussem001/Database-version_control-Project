<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Existing historical application migrations kept in their original file. -->
    <include file="db.application-changelog-master.sql" relativeToChangelogFile="true"/>

    <!-- New generated migrations created by the platform. Empty folder is allowed. -->
    <includeAll
            path="generated"
            relativeToChangelogFile="true"
            errorIfMissingOrEmpty="false"/>

</databaseChangeLog>